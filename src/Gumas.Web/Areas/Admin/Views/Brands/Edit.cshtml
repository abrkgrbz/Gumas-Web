@model BrandCreateDto
@{
    ViewData["Title"] = "Marka Düzenle";
}

<div class="max-w-4xl">
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b">
            <h2 class="font-semibold text-gray-800">
                <i class="fas fa-edit mr-2 text-gumas-red"></i>Marka Düzenle
            </h2>
        </div>

        <form asp-action="Edit" asp-route-id="@ViewBag.BrandId" method="post" class="p-6">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                    <ul class="list-disc list-inside">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="NameTr" class="block text-sm font-medium text-gray-700 mb-1">Türkçe Ad <span class="text-red-500">*</span></label>
                    <input asp-for="NameTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    <span asp-validation-for="NameTr" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="NameEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Ad</label>
                    <input asp-for="NameEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1">Slug <span class="text-red-500">*</span></label>
                    <input asp-for="Slug" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    <span asp-validation-for="Slug" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="LogoUrl" class="block text-sm font-medium text-gray-700 mb-1">Logo URL</label>
                    <input asp-for="LogoUrl" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="Website" class="block text-sm font-medium text-gray-700 mb-1">Website</label>
                    <input asp-for="Website" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="Country" class="block text-sm font-medium text-gray-700 mb-1">Ülke</label>
                    <input asp-for="Country" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="FoundedYear" class="block text-sm font-medium text-gray-700 mb-1">Kuruluş Yılı</label>
                    <input asp-for="FoundedYear" type="number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Sıralama</label>
                    <input asp-for="DisplayOrder" type="number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>
            </div>

            <div class="mt-6">
                <label asp-for="DescriptionTr" class="block text-sm font-medium text-gray-700 mb-1">Türkçe Açıklama</label>
                <textarea asp-for="DescriptionTr" rows="3" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
            </div>

            <div class="mt-6">
                <label asp-for="DescriptionEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Açıklama</label>
                <textarea asp-for="DescriptionEn" rows="3" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
            </div>

            <div class="mt-6 flex flex-wrap gap-6">
                <label class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" class="rounded text-gumas-red focus:ring-gumas-red">
                    <span class="ml-2 text-sm text-gray-700">Aktif</span>
                </label>
                <label class="flex items-center">
                    <input asp-for="IsFeatured" type="checkbox" class="rounded text-gumas-red focus:ring-gumas-red">
                    <span class="ml-2 text-sm text-gray-700">Öne Çıkan</span>
                </label>
            </div>

            <div class="mt-6 flex justify-end gap-4">
                <a href="@Url.Action("Index")" class="px-4 py-2 border rounded-lg hover:bg-gray-100">İptal</a>
                <button type="submit" class="px-4 py-2 bg-gumas-red text-white rounded-lg hover:bg-red-800">
                    <i class="fas fa-save mr-2"></i>Güncelle
                </button>
            </div>
        </form>
    </div>
</div>
