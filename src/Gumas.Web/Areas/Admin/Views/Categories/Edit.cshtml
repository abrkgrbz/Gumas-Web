@model Category
@{
    ViewData["Title"] = "Kategori Duzenle";
}

<div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b">
        <h2 class="font-semibold text-gray-800">
            <i class="fas fa-edit mr-2 text-gumas-red"></i>Kategori Duzenle
        </h2>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="p-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Turkish Content -->
            <div class="space-y-4">
                <h3 class="font-medium text-gray-700 border-b pb-2">
                    <i class="fas fa-flag mr-2"></i>Turkce Icerik
                </h3>

                <div>
                    <label asp-for="NameTr" class="block text-sm font-medium text-gray-700 mb-1">Kategori Adi (TR) *</label>
                    <input asp-for="NameTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" required />
                    <span asp-validation-for="NameTr" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="DescriptionTr" class="block text-sm font-medium text-gray-700 mb-1">Aciklama (TR)</label>
                    <textarea asp-for="DescriptionTr" rows="4" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                </div>
            </div>

            <!-- English Content -->
            <div class="space-y-4">
                <h3 class="font-medium text-gray-700 border-b pb-2">
                    <i class="fas fa-globe mr-2"></i>Ingilizce Icerik
                </h3>

                <div>
                    <label asp-for="NameEn" class="block text-sm font-medium text-gray-700 mb-1">Kategori Adi (EN)</label>
                    <input asp-for="NameEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" />
                </div>

                <div>
                    <label asp-for="DescriptionEn" class="block text-sm font-medium text-gray-700 mb-1">Aciklama (EN)</label>
                    <textarea asp-for="DescriptionEn" rows="4" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                </div>
            </div>
        </div>

        <!-- Current Image -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mt-6 border-t pt-6">
                <h3 class="font-medium text-gray-700 mb-4">Mevcut Gorsel</h3>
                <img src="@Model.ImageUrl" alt="@Model.NameTr" class="w-32 h-32 object-cover rounded-lg border" />
            </div>
        }

        <!-- Settings -->
        <div class="mt-6 border-t pt-6">
            <h3 class="font-medium text-gray-700 mb-4">
                <i class="fas fa-cog mr-2"></i>Ayarlar
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label asp-for="ParentId" class="block text-sm font-medium text-gray-700 mb-1">Ust Kategori</label>
                    <select asp-for="ParentId" asp-items="ViewBag.ParentCategories" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                        <option value="">-- Ana Kategori --</option>
                    </select>
                </div>

                <div>
                    <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Siralama</label>
                    <input asp-for="DisplayOrder" type="number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" />
                </div>

                <div>
                    <label asp-for="IconClass" class="block text-sm font-medium text-gray-700 mb-1">Ikon Sinifi</label>
                    <input asp-for="IconClass" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" placeholder="fas fa-cog" />
                    <p class="text-xs text-gray-500 mt-1">Ornek: fas fa-car, fas fa-tools</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Yeni Gorsel</label>
                    <input type="file" name="imageFile" accept="image/*" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" />
                    <p class="text-xs text-gray-500 mt-1">Bos birakirsaniz mevcut gorsel korunur.</p>
                </div>
            </div>

            <div class="mt-4">
                <label class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-gumas-red border-gray-300 rounded focus:ring-gumas-red" />
                    <span class="ml-2 text-sm text-gray-700">Aktif</span>
                </label>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-6 flex justify-end gap-4">
            <a href="@Url.Action("Index")" class="px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50">
                <i class="fas fa-times mr-2"></i>Iptal
            </a>
            <button type="submit" class="px-4 py-2 bg-gumas-red text-white rounded-lg hover:bg-red-800">
                <i class="fas fa-save mr-2"></i>Guncelle
            </button>
        </div>
    </form>
</div>
