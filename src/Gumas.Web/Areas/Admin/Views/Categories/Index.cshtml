@model IEnumerable<Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="bg-white rounded-lg shadow">
    <!-- Header -->
    <div class="px-6 py-4 border-b flex flex-wrap justify-between items-center gap-4">
        <h2 class="font-semibold text-gray-800">
            <i class="fas fa-folder mr-2 text-gumas-red"></i>Kategori Listesi
        </h2>
        <a href="@Url.Action("Create")" class="bg-gumas-red text-white px-4 py-2 rounded-lg hover:bg-red-800 transition-colors">
            <i class="fas fa-plus mr-2"></i>Yeni Kategori
        </a>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kategori</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ust Kategori</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sira</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Durum</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Islemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model.Any())
                {
                    @foreach (var category in Model.Where(c => c.ParentId == null))
                    {
                        <tr class="hover:bg-gray-50 bg-gray-25">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(category.ImageUrl))
                                    {
                                        <img src="@category.ImageUrl" alt="@category.NameTr" class="w-10 h-10 object-cover rounded">
                                    }
                                    else if (!string.IsNullOrEmpty(category.IconClass))
                                    {
                                        <div class="w-10 h-10 bg-gumas-red/10 rounded flex items-center justify-center">
                                            <i class="@category.IconClass text-gumas-red"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center">
                                            <i class="fas fa-folder text-gray-400"></i>
                                        </div>
                                    }
                                    <div class="ml-3">
                                        <p class="text-sm font-medium text-gray-900">@category.NameTr</p>
                                        <p class="text-xs text-gray-500">@category.NameEn</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">-</td>
                            <td class="px-6 py-4 text-sm text-gray-600">@category.DisplayOrder</td>
                            <td class="px-6 py-4">
                                <button type="button"
                                        onclick="toggleStatus(@category.Id, this)"
                                        class="status-badge @(category.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800") px-2 py-1 rounded-full text-xs cursor-pointer hover:opacity-80">
                                    @(category.IsActive ? "Aktif" : "Pasif")
                                </button>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="@Url.Action("Edit", new { id = category.Id })" class="text-blue-600 hover:text-blue-800 mr-3">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="inline" onsubmit="return confirm('Bu kategoriyi silmek istediginizden emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-800">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>

                        @* Alt kategoriler *@
                        @foreach (var child in category.Children?.OrderBy(c => c.DisplayOrder) ?? Enumerable.Empty<Category>())
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 pl-12">
                                    <div class="flex items-center">
                                        <i class="fas fa-level-up-alt fa-rotate-90 text-gray-300 mr-2"></i>
                                        @if (!string.IsNullOrEmpty(child.ImageUrl))
                                        {
                                            <img src="@child.ImageUrl" alt="@child.NameTr" class="w-8 h-8 object-cover rounded">
                                        }
                                        else
                                        {
                                            <div class="w-8 h-8 bg-gray-100 rounded flex items-center justify-center">
                                                <i class="fas fa-folder-open text-gray-400 text-xs"></i>
                                            </div>
                                        }
                                        <div class="ml-3">
                                            <p class="text-sm text-gray-800">@child.NameTr</p>
                                            <p class="text-xs text-gray-500">@child.NameEn</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-600">@category.NameTr</td>
                                <td class="px-6 py-4 text-sm text-gray-600">@child.DisplayOrder</td>
                                <td class="px-6 py-4">
                                    <button type="button"
                                            onclick="toggleStatus(@child.Id, this)"
                                            class="status-badge @(child.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800") px-2 py-1 rounded-full text-xs cursor-pointer hover:opacity-80">
                                        @(child.IsActive ? "Aktif" : "Pasif")
                                    </button>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a href="@Url.Action("Edit", new { id = child.Id })" class="text-blue-600 hover:text-blue-800 mr-3">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@child.Id" method="post" class="inline" onsubmit="return confirm('Bu kategoriyi silmek istediginizden emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-red-600 hover:text-red-800">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-folder-open text-4xl mb-3 block"></i>
                            Kategori bulunamadi.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    async function toggleStatus(id, button) {
        try {
            const response = await fetch(`/admin/categories/togglestatus/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            });
            const data = await response.json();
            if (data.success) {
                if (data.isActive) {
                    button.className = 'status-badge bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs cursor-pointer hover:opacity-80';
                    button.textContent = 'Aktif';
                } else {
                    button.className = 'status-badge bg-red-100 text-red-800 px-2 py-1 rounded-full text-xs cursor-pointer hover:opacity-80';
                    button.textContent = 'Pasif';
                }
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }
</script>
}
