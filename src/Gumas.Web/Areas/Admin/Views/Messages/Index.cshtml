@using Gumas.Domain.Enums
@model IEnumerable<ContactMessage>
@{
    ViewData["Title"] = "Mesajlar";
}

<div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b flex flex-wrap justify-between items-center gap-4">
        <h2 class="font-semibold text-gray-800">
            <i class="fas fa-envelope mr-2 text-gumas-red"></i>Gelen Mesajlar
            @if (ViewBag.UnreadCount > 0)
            {
                <span class="ml-2 bg-gumas-red text-white text-xs px-2 py-1 rounded-full">@ViewBag.UnreadCount okunmamış</span>
            }
        </h2>
        @if (ViewBag.UnreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 text-sm">
                    <i class="fas fa-check-double mr-2"></i>Tümünü Okundu İşaretle
                </button>
            </form>
        }
    </div>

    <div class="px-6 py-4 border-b bg-gray-50">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm text-gray-600 mb-1">Ara</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"
                       placeholder="İsim, email veya konu...">
            </div>
            <div class="w-40">
                <label class="block text-sm text-gray-600 mb-1">Durum</label>
                <select name="status" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red">
                    <option value="">Tümü</option>
                    <option value="@((int)MessageStatus.New)" selected="@(ViewBag.Status != null && (MessageStatus)ViewBag.Status == MessageStatus.New)">Okunmamış</option>
                    <option value="@((int)MessageStatus.Read)" selected="@(ViewBag.Status != null && (MessageStatus)ViewBag.Status == MessageStatus.Read)">Okunmuş</option>
                    <option value="@((int)MessageStatus.Replied)" selected="@(ViewBag.Status != null && (MessageStatus)ViewBag.Status == MessageStatus.Replied)">Yanıtlandı</option>
                    <option value="@((int)MessageStatus.Archived)" selected="@(ViewBag.Status != null && (MessageStatus)ViewBag.Status == MessageStatus.Archived)">Arşivlendi</option>
                </select>
            </div>
            <button type="submit" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700">
                <i class="fas fa-search mr-2"></i>Filtrele
            </button>
        </form>
    </div>

    <div class="divide-y divide-gray-200">
        @if (Model.Any())
        {
            @foreach (var message in Model)
            {
                var isUnread = message.Status == MessageStatus.New;
                <div class="px-6 py-4 hover:bg-gray-50 @(isUnread ? "bg-red-50" : "")">
                    <div class="flex items-start justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-1">
                                <span class="font-medium text-gray-900 @(isUnread ? "font-bold" : "")">
                                    @message.FullName
                                </span>
                                @if (isUnread)
                                {
                                    <span class="bg-gumas-red text-white text-xs px-2 py-0.5 rounded-full">Yeni</span>
                                }
                            </div>
                            <p class="text-sm text-gray-600 mb-1">@message.Subject</p>
                            <p class="text-xs text-gray-500">
                                <i class="fas fa-envelope mr-1"></i>@message.Email
                                @if (!string.IsNullOrEmpty(message.Phone))
                                {
                                    <span class="ml-3"><i class="fas fa-phone mr-1"></i>@message.Phone</span>
                                }
                            </p>
                        </div>
                        <div class="text-right ml-4">
                            <p class="text-xs text-gray-400 mb-2">@message.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                            <div class="flex gap-2 justify-end">
                                <a href="@Url.Action("Detail", new { id = message.Id })" class="text-blue-600 hover:text-blue-800" title="Görüntüle">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (message.Status != MessageStatus.New)
                                {
                                    <form asp-action="MarkAsUnread" asp-route-id="@message.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-yellow-600 hover:text-yellow-800" title="Okunmadı İşaretle">
                                            <i class="fas fa-envelope"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@message.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-green-600 hover:text-green-800" title="Okundu İşaretle">
                                            <i class="fas fa-envelope-open"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@message.Id" method="post" class="inline" onsubmit="return confirm('Bu mesajı silmek istediğinizden emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-800" title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="px-6 py-12 text-center text-gray-500">
                <i class="fas fa-inbox text-4xl mb-3 block"></i>
                Mesaj bulunamadı.
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="px-6 py-4 border-t flex justify-center">
            <nav class="flex space-x-2">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a href="@Url.Action("Index", new { page = i, search = ViewBag.Search, status = ViewBag.Status })"
                       class="px-3 py-1 rounded @(i == ViewBag.CurrentPage ? "bg-gumas-red text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300")">
                        @i
                    </a>
                }
            </nav>
        </div>
    }
</div>
