@model News
@{
    ViewData["Title"] = "Yeni Haber";
}

<div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b">
        <h2 class="font-semibold text-gray-800">
            <i class="fas fa-plus mr-2 text-gumas-red"></i>Yeni Haber Ekle
        </h2>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-6">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Turkish Content -->
            <div class="space-y-4">
                <h3 class="font-medium text-gray-700 border-b pb-2">
                    <i class="fas fa-flag mr-2"></i>Turkce Icerik
                </h3>

                <div>
                    <label asp-for="NameTr" class="block text-sm font-medium text-gray-700 mb-1">Baslik (TR) *</label>
                    <input asp-for="NameTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" required />
                    <span asp-validation-for="NameTr" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="SummaryTr" class="block text-sm font-medium text-gray-700 mb-1">Ozet (TR)</label>
                    <textarea asp-for="SummaryTr" rows="3" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                </div>

                <div>
                    <label asp-for="ContentTr" class="block text-sm font-medium text-gray-700 mb-1">Icerik (TR)</label>
                    <textarea asp-for="ContentTr" rows="8" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                </div>
            </div>

            <!-- English Content -->
            <div class="space-y-4">
                <h3 class="font-medium text-gray-700 border-b pb-2">
                    <i class="fas fa-globe mr-2"></i>Ingilizce Icerik
                </h3>

                <div>
                    <label asp-for="NameEn" class="block text-sm font-medium text-gray-700 mb-1">Baslik (EN)</label>
                    <input asp-for="NameEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" />
                </div>

                <div>
                    <label asp-for="SummaryEn" class="block text-sm font-medium text-gray-700 mb-1">Ozet (EN)</label>
                    <textarea asp-for="SummaryEn" rows="3" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                </div>

                <div>
                    <label asp-for="ContentEn" class="block text-sm font-medium text-gray-700 mb-1">Icerik (EN)</label>
                    <textarea asp-for="ContentEn" rows="8" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                </div>
            </div>
        </div>

        <!-- Settings -->
        <div class="mt-6 border-t pt-6">
            <h3 class="font-medium text-gray-700 mb-4">
                <i class="fas fa-cog mr-2"></i>Ayarlar
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="PublishDate" class="block text-sm font-medium text-gray-700 mb-1">Yayin Tarihi *</label>
                    <input asp-for="PublishDate" type="datetime-local" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" required />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Gorsel</label>
                    <input type="file" name="imageFile" accept="image/*" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent" />
                </div>

                <div class="flex items-center pt-6">
                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-gumas-red border-gray-300 rounded focus:ring-gumas-red" />
                    <label asp-for="IsActive" class="ml-2 text-sm text-gray-700">Aktif</label>
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-6 flex justify-end gap-4">
            <a href="@Url.Action("Index")" class="px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50">
                <i class="fas fa-times mr-2"></i>Iptal
            </a>
            <button type="submit" class="px-4 py-2 bg-gumas-red text-white rounded-lg hover:bg-red-800">
                <i class="fas fa-save mr-2"></i>Kaydet
            </button>
        </div>
    </form>
</div>
