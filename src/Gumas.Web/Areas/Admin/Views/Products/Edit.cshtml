@model ProductCreateDto
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="max-w-4xl">
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b">
            <h2 class="font-semibold text-gray-800">
                <i class="fas fa-edit mr-2 text-gumas-red"></i>Ürün Düzenle
            </h2>
        </div>

        <form asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post" class="p-6">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                    <ul class="list-disc list-inside">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="NameTr" class="block text-sm font-medium text-gray-700 mb-1">
                        Türkçe Ad <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="NameTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    <span asp-validation-for="NameTr" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="NameEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Ad</label>
                    <input asp-for="NameEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1">
                        Slug <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Slug" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    <span asp-validation-for="Slug" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="ProductCode" class="block text-sm font-medium text-gray-700 mb-1">Ürün Kodu</label>
                    <input asp-for="ProductCode" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="BrandId" class="block text-sm font-medium text-gray-700 mb-1">
                        Marka <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="BrandId" asp-items="ViewBag.Brands" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="BrandId" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700 mb-1">
                        Kategori <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="OemNumber" class="block text-sm font-medium text-gray-700 mb-1">OEM Numarası</label>
                    <input asp-for="OemNumber" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Sıralama</label>
                    <input asp-for="DisplayOrder" type="number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>
            </div>

            <div class="mt-6">
                <label asp-for="DescriptionTr" class="block text-sm font-medium text-gray-700 mb-1">Türkçe Açıklama</label>
                <textarea asp-for="DescriptionTr" rows="3" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
            </div>

            <div class="mt-6">
                <label asp-for="DescriptionEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Açıklama</label>
                <textarea asp-for="DescriptionEn" rows="3" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
            </div>

            <div class="mt-6 flex flex-wrap gap-6">
                <label class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" class="rounded text-gumas-red focus:ring-gumas-red">
                    <span class="ml-2 text-sm text-gray-700">Aktif</span>
                </label>
                <label class="flex items-center">
                    <input asp-for="IsFeatured" type="checkbox" class="rounded text-gumas-red focus:ring-gumas-red">
                    <span class="ml-2 text-sm text-gray-700">Öne Çıkan</span>
                </label>
                <label class="flex items-center">
                    <input asp-for="IsNew" type="checkbox" class="rounded text-gumas-red focus:ring-gumas-red">
                    <span class="ml-2 text-sm text-gray-700">Yeni Ürün</span>
                </label>
            </div>

            <div class="mt-6 p-4 bg-gray-50 rounded-lg">
                <h3 class="font-medium text-gray-800 mb-4"><i class="fas fa-search mr-2"></i>SEO Ayarları</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="MetaTitleTr" class="block text-sm font-medium text-gray-700 mb-1">Meta Başlık (TR)</label>
                        <input asp-for="MetaTitleTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    </div>
                    <div>
                        <label asp-for="MetaTitleEn" class="block text-sm font-medium text-gray-700 mb-1">Meta Başlık (EN)</label>
                        <input asp-for="MetaTitleEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    </div>
                    <div>
                        <label asp-for="MetaDescriptionTr" class="block text-sm font-medium text-gray-700 mb-1">Meta Açıklama (TR)</label>
                        <textarea asp-for="MetaDescriptionTr" rows="2" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                    </div>
                    <div>
                        <label asp-for="MetaDescriptionEn" class="block text-sm font-medium text-gray-700 mb-1">Meta Açıklama (EN)</label>
                        <textarea asp-for="MetaDescriptionEn" rows="2" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"></textarea>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-4">
                <a href="@Url.Action("Index")" class="px-4 py-2 border rounded-lg hover:bg-gray-100">İptal</a>
                <button type="submit" class="px-4 py-2 bg-gumas-red text-white rounded-lg hover:bg-red-800">
                    <i class="fas fa-save mr-2"></i>Güncelle
                </button>
            </div>
        </form>
    </div>
</div>
