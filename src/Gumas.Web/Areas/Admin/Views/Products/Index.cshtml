@model IEnumerable<Product>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="bg-white rounded-lg shadow">
    <!-- Header -->
    <div class="px-6 py-4 border-b flex flex-wrap justify-between items-center gap-4">
        <h2 class="font-semibold text-gray-800">
            <i class="fas fa-box mr-2 text-gumas-red"></i>Ürün Listesi
        </h2>
        <a href="@Url.Action("Create")" class="bg-gumas-red text-white px-4 py-2 rounded-lg hover:bg-red-800 transition-colors">
            <i class="fas fa-plus mr-2"></i>Yeni Ürün
        </a>
    </div>

    <!-- Filters -->
    <div class="px-6 py-4 border-b bg-gray-50">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm text-gray-600 mb-1">Ara</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent"
                       placeholder="Ürün adı veya kodu...">
            </div>
            <div class="w-48">
                <label class="block text-sm text-gray-600 mb-1">Marka</label>
                <select name="brandId" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red">
                    <option value="">Tümü</option>
                    @foreach (SelectListItem item in ViewBag.Brands)
                    {
                        <option value="@item.Value" selected="@(item.Value == ViewBag.BrandId?.ToString())">@item.Text</option>
                    }
                </select>
            </div>
            <div class="w-48">
                <label class="block text-sm text-gray-600 mb-1">Kategori</label>
                <select name="categoryId" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red">
                    <option value="">Tümü</option>
                    @foreach (SelectListItem item in ViewBag.Categories)
                    {
                        <option value="@item.Value" selected="@(item.Value == ViewBag.CategoryId?.ToString())">@item.Text</option>
                    }
                </select>
            </div>
            <button type="submit" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700">
                <i class="fas fa-search mr-2"></i>Filtrele
            </button>
        </form>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ürün</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Marka</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kategori</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Durum</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Öne Çıkan</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model.Any())
                {
                    @foreach (var product in Model)
                    {
                        var productImage = product.Images?.FirstOrDefault()?.ImageUrl;
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(productImage))
                                    {
                                        <img src="@productImage" alt="@product.NameTr" class="w-12 h-12 object-cover rounded">
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 bg-gray-200 rounded flex items-center justify-center">
                                            <i class="fas fa-image text-gray-400"></i>
                                        </div>
                                    }
                                    <div class="ml-3">
                                        <p class="text-sm font-medium text-gray-900">@product.NameTr</p>
                                        <p class="text-xs text-gray-500">@product.ProductCode</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">@product.Brand?.NameTr</td>
                            <td class="px-6 py-4 text-sm text-gray-600">@product.Category?.NameTr</td>
                            <td class="px-6 py-4">
                                <form asp-action="ToggleActive" asp-route-id="@product.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="@(product.IsActive ? "text-green-600" : "text-red-600") hover:underline text-sm">
                                        @if (product.IsActive)
                                        {
                                            <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="bg-red-100 text-red-800 px-2 py-1 rounded-full text-xs">Pasif</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4">
                                <form asp-action="ToggleFeatured" asp-route-id="@product.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-yellow-500 hover:text-yellow-600">
                                        <i class="@(product.IsFeatured ? "fas" : "far") fa-star"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="@Url.Action("Edit", new { id = product.Id })" class="text-blue-600 hover:text-blue-800 mr-3">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="inline" onsubmit="return confirm('Bu ürünü silmek istediğinizden emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-800">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-box-open text-4xl mb-3 block"></i>
                            Ürün bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="px-6 py-4 border-t flex justify-center">
            <nav class="flex space-x-2">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a href="@Url.Action("Index", new { page = i, search = ViewBag.Search, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId })"
                       class="px-3 py-1 rounded @(i == ViewBag.CurrentPage ? "bg-gumas-red text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300")">
                        @i
                    </a>
                }
            </nav>
        </div>
    }
</div>
