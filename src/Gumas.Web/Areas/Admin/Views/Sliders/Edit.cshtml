@model Slider
@{
    ViewData["Title"] = "Slider Düzenle";
}

<div class="max-w-4xl">
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b">
            <h2 class="font-semibold text-gray-800">
                <i class="fas fa-edit mr-2 text-gumas-red"></i>Slider Düzenle
            </h2>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                    <ul class="list-disc list-inside">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Mevcut Görsel</label>
                    <img src="@Model.ImageUrl" alt="@Model.TitleTr" class="w-64 h-40 object-cover rounded border">
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="TitleTr" class="block text-sm font-medium text-gray-700 mb-1">Türkçe Başlık</label>
                    <input asp-for="TitleTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="TitleEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Başlık</label>
                    <input asp-for="TitleEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="SubtitleTr" class="block text-sm font-medium text-gray-700 mb-1">Türkçe Alt Başlık</label>
                    <input asp-for="SubtitleTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="SubtitleEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Alt Başlık</label>
                    <input asp-for="SubtitleEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div class="md:col-span-2">
                    <label asp-for="ImageUrl" class="block text-sm font-medium text-gray-700 mb-1">Görsel URL <span class="text-red-500">*</span></label>
                    <input asp-for="ImageUrl" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                    <span asp-validation-for="ImageUrl" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="MobileImageUrl" class="block text-sm font-medium text-gray-700 mb-1">Mobil Görsel URL</label>
                    <input asp-for="MobileImageUrl" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="ButtonUrl" class="block text-sm font-medium text-gray-700 mb-1">Buton URL</label>
                    <input asp-for="ButtonUrl" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="ButtonTextTr" class="block text-sm font-medium text-gray-700 mb-1">Türkçe Buton Metni</label>
                    <input asp-for="ButtonTextTr" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="ButtonTextEn" class="block text-sm font-medium text-gray-700 mb-1">İngilizce Buton Metni</label>
                    <input asp-for="ButtonTextEn" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>

                <div>
                    <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Sıralama</label>
                    <input asp-for="DisplayOrder" type="number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-gumas-red focus:border-transparent">
                </div>
            </div>

            <div class="mt-6">
                <label class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" class="rounded text-gumas-red focus:ring-gumas-red">
                    <span class="ml-2 text-sm text-gray-700">Aktif</span>
                </label>
            </div>

            <div class="mt-6 flex justify-end gap-4">
                <a href="@Url.Action("Index")" class="px-4 py-2 border rounded-lg hover:bg-gray-100">İptal</a>
                <button type="submit" class="px-4 py-2 bg-gumas-red text-white rounded-lg hover:bg-red-800">
                    <i class="fas fa-save mr-2"></i>Güncelle
                </button>
            </div>
        </form>
    </div>
</div>
