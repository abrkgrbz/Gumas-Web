@model IEnumerable<Slider>
@{
    ViewData["Title"] = "Sliderlar";
}

<div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b flex justify-between items-center">
        <h2 class="font-semibold text-gray-800">
            <i class="fas fa-images mr-2 text-gumas-red"></i>Slider Listesi
        </h2>
        <a href="@Url.Action("Create")" class="bg-gumas-red text-white px-4 py-2 rounded-lg hover:bg-red-800 transition-colors">
            <i class="fas fa-plus mr-2"></i>Yeni Slider
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Görsel</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Başlık</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sıra</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Durum</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model.Any())
                {
                    @foreach (var slider in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(slider.ImageUrl))
                                {
                                    <img src="@slider.ImageUrl" alt="@slider.TitleTr" class="w-32 h-20 object-cover rounded">
                                }
                                else
                                {
                                    <div class="w-32 h-20 bg-gray-200 rounded flex items-center justify-center">
                                        <i class="fas fa-image text-gray-400 text-2xl"></i>
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm font-medium text-gray-900">@slider.TitleTr</p>
                                <p class="text-xs text-gray-500">@slider.SubtitleTr</p>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">@slider.DisplayOrder</td>
                            <td class="px-6 py-4">
                                <form asp-action="ToggleActive" asp-route-id="@slider.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">
                                        @if (slider.IsActive)
                                        {
                                            <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="bg-red-100 text-red-800 px-2 py-1 rounded-full text-xs">Pasif</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="@Url.Action("Edit", new { id = slider.Id })" class="text-blue-600 hover:text-blue-800 mr-3">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@slider.Id" method="post" class="inline" onsubmit="return confirm('Bu slider\'ı silmek istediğinizden emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-800">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-images text-4xl mb-3 block"></i>
                            Slider bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
