@model BrandsViewModel
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEnglish = currentCulture == "en";
    ViewData["Title"] = isEnglish ? "Brands" : "Markalar";
    var brandDetailUrl = isEnglish ? "/en/brand" : "/marka";
    var contactUrl = isEnglish ? "/en/contact" : "/iletisim";
}

<!-- Main Content -->
<main class="pt-20 pb-20 bg-white dark:bg-gumas-dark transition-colors duration-300">

    <!-- Page Header -->
    <section class="container mx-auto px-6 mb-20 relative z-10">
        <h1 class="text-6xl md:text-8xl font-oswald font-bold uppercase mb-6 text-black dark:text-white">
            @L["Brands_Title"]<span class="text-gumas-gray">@L["Brands_TitleSuffix"]</span>
        </h1>
        <p class="max-w-2xl text-gray-600 dark:text-gray-400 font-light">
            @L["Brands_Description"]
        </p>
    </section>

    <!-- Brands Grid -->
    <section class="container mx-auto px-6 relative z-10">
        @if (Model.Brands.Any())
        {
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                @foreach (var brand in Model.Brands)
                {
                    var bSlug = brand.Slug?.ToLowerInvariant();
                    var isGerflorBrand = bSlug == "gerflor";

                    @if (isGerflorBrand)
                    {
                        <div onclick="document.getElementById('gerflor-brands-modal').classList.remove('hidden')"
                             class="bg-white border border-gray-200 dark:bg-white/[0.02] dark:border-white/5 aspect-[3/2] flex flex-col items-center justify-center p-6 grayscale hover:grayscale-0 hover:border-gumas-red dark:hover:bg-white/5 transition-all duration-500 group cursor-pointer">
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <img src="@brand.LogoUrl" alt="@brand.GetName(currentCulture)"
                                     class="max-h-20 max-w-[85%] object-contain mb-3 opacity-60 group-hover:opacity-100 transition-opacity duration-500" />
                            }
                            else
                            {
                                <span class="font-oswald text-3xl tracking-widest text-gray-400 dark:text-gray-600 group-hover:text-black dark:group-hover:text-white transition-colors">
                                    @brand.GetName(currentCulture)
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <span class="text-xs font-oswald uppercase tracking-wider text-gray-400 dark:text-gray-600 group-hover:text-gumas-red transition-colors mt-2">
                                    @brand.GetName(currentCulture)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <a href="@brandDetailUrl/@brand.Slug"
                           class="bg-white border border-gray-200 dark:bg-white/[0.02] dark:border-white/5 aspect-[3/2] flex flex-col items-center justify-center p-6 grayscale hover:grayscale-0 hover:border-gumas-red dark:hover:bg-white/5 transition-all duration-500 group">
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <img src="@brand.LogoUrl" alt="@brand.GetName(currentCulture)"
                                     class="max-h-20 max-w-[85%] object-contain mb-3 opacity-60 group-hover:opacity-100 transition-opacity duration-500" />
                            }
                            else
                            {
                                <span class="font-oswald text-3xl tracking-widest text-gray-400 dark:text-gray-600 group-hover:text-black dark:group-hover:text-white transition-colors">
                                    @brand.GetName(currentCulture)
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <span class="text-xs font-oswald uppercase tracking-wider text-gray-400 dark:text-gray-600 group-hover:text-gumas-red transition-colors mt-2">
                                    @brand.GetName(currentCulture)
                                </span>
                            }
                        </a>
                    }
                }
            </div>

            <!-- GERFLOR Markalar Modalı (Madde 6) -->
            <div id="gerflor-brands-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm" onclick="if(event.target===this)this.classList.add('hidden')">
                <div class="bg-white dark:bg-gumas-dark border border-gray-200 dark:border-white/10 w-full max-w-md mx-4 shadow-2xl">
                    <div class="flex items-center justify-between px-8 py-6 border-b border-gray-100 dark:border-white/10">
                        <div>
                            <span class="font-oswald text-xs uppercase tracking-[0.4em] text-gumas-red block mb-1">GERFLOR</span>
                            <h3 class="font-oswald text-2xl font-bold uppercase text-black dark:text-white">
                                @(isEnglish ? "Select Category" : "Kategori Seçin")
                            </h3>
                        </div>
                        <button onclick="document.getElementById('gerflor-brands-modal').classList.add('hidden')" class="text-gray-400 hover:text-black dark:hover:text-white transition-colors text-2xl leading-none">&times;</button>
                    </div>
                    <div class="p-8 flex flex-col gap-4">
                        <a href="https://www.gerflortransport.com/en/bus/outstanding-floor-coverings-buses-and-coaches" target="_blank" rel="noopener"
                           class="flex items-center justify-between px-6 py-5 border border-gray-200 dark:border-white/10 hover:border-gumas-red hover:bg-gray-50 dark:hover:bg-black/30 transition-all group">
                            <span class="font-oswald text-lg font-bold uppercase text-black dark:text-white group-hover:text-gumas-red transition-colors">
                                @(isEnglish ? "BUS" : "OTOBÜS")
                            </span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-sm text-gray-400 group-hover:text-gumas-red transition-colors"></i>
                        </a>
                        <a href="https://www.gerflortransport.com/en/rail/gerflors-expertise-elevating-rail-vehicle-flooring-solutions" target="_blank" rel="noopener"
                           class="flex items-center justify-between px-6 py-5 border border-gray-200 dark:border-white/10 hover:border-gumas-red hover:bg-gray-50 dark:hover:bg-black/30 transition-all group">
                            <span class="font-oswald text-lg font-bold uppercase text-black dark:text-white group-hover:text-gumas-red transition-colors">
                                @(isEnglish ? "TRAIN" : "TREN")
                            </span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-sm text-gray-400 group-hover:text-gumas-red transition-colors"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- No Brands -->
            <div class="text-center py-20">
                <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gray-100 dark:bg-gumas-gray flex items-center justify-center">
                    <i class="fa-solid fa-building text-4xl text-gray-400"></i>
                </div>
                <h3 class="text-2xl font-oswald uppercase text-black dark:text-white mb-4">@L["Brands_NoResults"]</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">
                    @L["Brands_NoResultsDesc"]
                </p>
            </div>
        }
    </section>

    <!-- CTA Section -->
    <section class="container mx-auto px-6 mt-32 relative z-10">
        <div class="bg-gumas-dark dark:bg-gumas-gray p-12 md:p-20 text-center">
            <h2 class="text-3xl md:text-5xl font-oswald font-bold uppercase mb-6 text-white">
                @L["Brands_CtaTitle"] <span class="text-gumas-red">@L["Brands_CtaTitleHighlight"]</span>
            </h2>
            <p class="text-gray-400 mb-10 max-w-2xl mx-auto">
                @L["Brands_CtaDescription"]
            </p>
            <a href="@contactUrl"
               class="inline-block font-oswald border-2 border-white text-white px-10 py-4 uppercase text-sm tracking-widest hover:bg-gumas-red hover:border-gumas-red transition-all duration-300">
                <i class="fa-solid fa-envelope mr-2"></i> @L["Nav_Contact"]
            </a>
        </div>
    </section>

</main>
