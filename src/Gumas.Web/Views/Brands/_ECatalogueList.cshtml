<div class="space-y-8">
    @foreach (var group in catalogueGroups)
    {
        <div class="border border-gray-200 dark:border-white/10 bg-white dark:bg-gumas-gray">
            <div class="px-6 py-5 border-b border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-black/30">
                <div class="text-xl md:text-2xl font-oswald font-bold uppercase tracking-wider text-gumas-red mb-2">@group.Brand</div>
                <h3 class="text-lg md:text-2xl font-oswald font-bold uppercase text-black dark:text-white">
                    @group.Category
                </h3>
            </div>
            <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var item in group.Items)
                {
                    <li class="border-b border-r border-gray-100 dark:border-white/5 last:border-b-0">
                        <a href="@item.Url" target="_blank" rel="noopener"
                           class="flex items-center justify-between px-6 py-4 text-sm text-gray-700 dark:text-gray-300 hover:text-gumas-red hover:bg-gray-50 dark:hover:bg-black/30 transition-colors group h-full">
                            <span class="pr-3">@item.Title</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-40 group-hover:opacity-100 transition-opacity flex-shrink-0"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
