@model ContactViewModel
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEnglish = currentCulture == "en";
    ViewData["Title"] = isEnglish ? "Contact" : "İletişim";
}

<!-- Main Content -->
<main class="pt-[10rem] pb-20 min-h-screen bg-white dark:bg-gumas-dark transition-colors duration-300">

    <!-- Page Header -->
    <section class="container mx-auto px-6 mb-20 relative z-10">
        <h1 class="text-6xl md:text-8xl font-oswald font-bold uppercase mb-6 text-black dark:text-white">
            @L["Contact_Title"] <span class="text-gumas-gray">@L["Contact_TitleSuffix"]</span>
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
            <!-- Contact Info -->
            <div>
                <p class="text-xl text-black dark:text-white mb-12 font-light leading-relaxed">
                    @L["Contact_Description"]
                </p>

                <div class="space-y-8">
                    <div>
                        <h4 class="font-oswald text-gumas-red uppercase tracking-widest mb-2">@L["Contact_Headquarters"]</h4>
                        <p class="text-gray-600 dark:text-gray-400 font-light">
                            @L["Footer_CompanyName"]<br />
                            Dolapdere Taksim Cad. No:35 Kat:2<br />
                            34437 Beyoğlu - İstanbul
                        </p>
                    </div>
                    <div>
                        <h4 class="font-oswald text-gumas-red uppercase tracking-widest mb-2">@L["Contact_Email"]</h4>
                        <a href="mailto:info@gumas.com.tr"
                           class="text-gray-600 dark:text-gray-400 font-light hover:text-black dark:hover:text-white transition-colors">
                            info@gumas.com.tr
                        </a>
                    </div>
                    <div>
                        <h4 class="font-oswald text-gumas-red uppercase tracking-widest mb-2">@L["Contact_Phone"]</h4>
                        <a href="tel:+902122547805"
                           class="text-gray-600 dark:text-gray-400 font-light hover:text-black dark:hover:text-white transition-colors block">
                            +90 212 254 78 05 - 06
                        </a>
                        <span class="text-gray-500 dark:text-gray-500 font-light text-sm block mt-1">
                            @(isEnglish ? "Fax" : "Faks"): +90 212 256 17 86
                        </span>
                    </div>
                    <div>
                        <h4 class="font-oswald text-gumas-red uppercase tracking-widest mb-2">@L["Contact_WorkingHours"]</h4>
                        <p class="text-gray-600 dark:text-gray-400 font-light">
                            @L["Contact_WeekdayHours"]<br />
                            @L["Contact_SundayHours"]
                        </p>
                    </div>
                </div>

                <!-- Social Links -->
                <div class="mt-12 pt-8 border-t border-black/10 dark:border-white/10">
                    <h4 class="font-oswald text-gumas-red uppercase tracking-widest mb-4">@L["Contact_SocialMedia"]</h4>
                    <div class="flex space-x-4">
                        <a href="https://www.linkedin.com/company/gümaş-a-ş/" target="_blank" class="w-12 h-12 border border-gray-300 dark:border-white/20 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:bg-gumas-red hover:border-gumas-red hover:text-white transition-all duration-300">
                            <i class="fa-brands fa-linkedin-in"></i>
                        </a>
                        <a href="https://wa.me/905412547805" target="_blank" class="w-12 h-12 border border-gray-300 dark:border-white/20 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:bg-gumas-red hover:border-gumas-red hover:text-white transition-all duration-300">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div>
                @if (Model.IsSuccess)
                {
                    <div class="bg-green-500/10 border border-green-500/30 p-6 mb-8">
                        <div class="flex items-center gap-3 text-green-600 dark:text-green-400">
                            <i class="fa-solid fa-check-circle text-xl"></i>
                            <span>@Model.SuccessMessage</span>
                        </div>
                    </div>
                }

                <form asp-action="Index" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <input asp-for="FullName"
                                   placeholder="@L["Contact_FullName"]"
                                   class="w-full bg-transparent border-b border-black/20 dark:border-white/20 py-4 text-black dark:text-white placeholder-gray-500 focus:border-gumas-red outline-none transition-colors" />
                            <span asp-validation-for="FullName" class="text-gumas-red text-sm mt-1 block"></span>
                        </div>
                        <div>
                            <input asp-for="Phone"
                                   placeholder="@L["Contact_PhoneField"]"
                                   class="w-full bg-transparent border-b border-black/20 dark:border-white/20 py-4 text-black dark:text-white placeholder-gray-500 focus:border-gumas-red outline-none transition-colors" />
                            <span asp-validation-for="Phone" class="text-gumas-red text-sm mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <input asp-for="Email"
                               placeholder="@L["Contact_EmailField"]"
                               class="w-full bg-transparent border-b border-black/20 dark:border-white/20 py-4 text-black dark:text-white placeholder-gray-500 focus:border-gumas-red outline-none transition-colors" />
                        <span asp-validation-for="Email" class="text-gumas-red text-sm mt-1 block"></span>
                    </div>

                    <div>
                        <input asp-for="Subject"
                               placeholder="@L["Contact_Subject"]"
                               class="w-full bg-transparent border-b border-black/20 dark:border-white/20 py-4 text-black dark:text-white placeholder-gray-500 focus:border-gumas-red outline-none transition-colors" />
                        <span asp-validation-for="Subject" class="text-gumas-red text-sm mt-1 block"></span>
                    </div>

                    <div>
                        <textarea asp-for="Message"
                                  rows="4"
                                  placeholder="@L["Contact_Message"]"
                                  class="w-full bg-transparent border-b border-black/20 dark:border-white/20 py-4 text-black dark:text-white placeholder-gray-500 focus:border-gumas-red outline-none transition-colors resize-none"></textarea>
                        <span asp-validation-for="Message" class="text-gumas-red text-sm mt-1 block"></span>
                    </div>

                    <button type="submit"
                            class="bg-black text-white dark:bg-white dark:text-black font-oswald uppercase tracking-widest px-10 py-4 font-bold hover:bg-gumas-red hover:text-white dark:hover:bg-gumas-red dark:hover:text-white transition-colors duration-300 w-full md:w-auto">
                        <i class="fa-solid fa-paper-plane mr-2"></i>
                        @L["Contact_SendMessage"]
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="w-full h-[500px] relative border-t border-black/10 dark:border-white/10 map-container">
        <iframe
            src="https://maps.google.com/maps?q=Dolapdere%20Taksim%20Cad.%20No%3A35%20Beyo%C4%9Flu%20%C4%B0stanbul&t=m&z=17&output=embed&iwloc=near"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="grayscale dark:grayscale dark:invert dark:contrast-125">
        </iframe>
    </section>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .map-container iframe {
            filter: none;
            transition: filter 0.3s ease;
        }

        .dark .map-container iframe {
            filter: grayscale(100%) invert(90%) contrast(120%);
        }
    </style>
}
