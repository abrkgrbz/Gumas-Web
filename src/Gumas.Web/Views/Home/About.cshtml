@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEnglish = currentCulture == "en";
    ViewData["Title"] = isEnglish ? "About Us" : "Hakkımızda";
    var contactUrl = isEnglish ? "/en/contact" : "/iletisim";
}

<!-- Main Content -->
<main class="pt-32 pb-20 bg-white dark:bg-gumas-dark transition-colors duration-300">

    <!-- Hero Section -->
    <section class="container mx-auto px-6 mb-32 relative z-10">
        <span class="text-gumas-red font-oswald uppercase tracking-widest text-sm mb-4 block">@L["About_Since1985"]</span>
        <h1 class="text-6xl md:text-9xl font-oswald font-bold uppercase mb-12 text-black dark:text-white">
            @L["About_HeroTitle1"] <span class="text-gumas-gray">@L["About_HeroTitle2"]</span>
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-gray-600 dark:text-gray-300 font-light text-lg leading-relaxed">
            <p>
                @L["About_Intro1"]
            </p>
            <p>
                @L["About_Intro2"]
            </p>
        </div>
    </section>

    <!-- Global Supply Image Section (JOST sites) -->
    <section class="container mx-auto px-6 mb-32 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative w-full h-[45vh] overflow-hidden group">
                <div class="absolute inset-0 bg-cover bg-center grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700 transform group-hover:scale-105"
                     style="background-image: url('/images/about/jost-neu-isenburg.jpg');">
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                <div class="absolute bottom-6 left-6 right-6">
                    <span class="inline-block bg-gumas-red text-white font-oswald uppercase tracking-widest text-xs px-3 py-1.5">
                        JOST · Neu-Isenburg
                    </span>
                </div>
            </div>
            <div class="relative w-full h-[45vh] overflow-hidden group">
                <div class="absolute inset-0 bg-cover bg-center grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700 transform group-hover:scale-105"
                     style="background-image: url('/images/about/jost-erfurt.jpg');">
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                <div class="absolute bottom-6 left-6 right-6">
                    <span class="inline-block bg-gumas-red text-white font-oswald uppercase tracking-widest text-xs px-3 py-1.5">
                        JOST · Erfurt
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Vision/Values -->
    <section class="container mx-auto px-6 mb-20 relative z-10">
        <h2 class="text-6xl md:text-8xl font-oswald font-bold uppercase mb-6 text-black dark:text-white">
            @L["About_HistoryTitle1"] <span class="text-gumas-gray">@L["About_HistoryTitle2"]</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
            <div>
                <p class="text-xl text-black dark:text-white mb-8 font-light leading-relaxed">
                    @L["About_HistoryText1"]
                </p>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-lg mb-8">
                    @L["About_HistoryText2"]
                </p>

                <div class="grid grid-cols-2 gap-8 border-t border-black/10 dark:border-white/10 pt-8 mt-12">
                    <div>
                        <span class="block text-4xl font-oswald font-bold text-gumas-red mb-2">40+</span>
                        <span class="text-sm uppercase tracking-widest text-gray-500">@L["About_YearsExperience"]</span>
                    </div>
                    <div>
                        <span class="block text-4xl font-oswald font-bold text-gumas-red mb-2">12K+</span>
                        <span class="text-sm uppercase tracking-widest text-gray-500">@L["About_ProductReferences"]</span>
                    </div>
                </div>
            </div>
            <div class="relative group">
                <div class="w-full h-full min-h-[400px] bg-gray-200 dark:bg-white/10 relative overflow-hidden">
                    <img src="/images/8.jpg"
                         alt="@L["About_IndustrialLogistics"]"
                         class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-100 transition-all duration-700 transform group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-br from-gumas-red/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="container mx-auto px-6 mb-20 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Mission -->
            <div class="bg-white dark:bg-gumas-gray border border-gray-200 dark:border-white/10 p-12 hover:border-gumas-red transition-colors duration-300">
                <div class="w-16 h-16 bg-gumas-red/10 flex items-center justify-center mb-6">
                    <i class="fa-solid fa-bullseye text-2xl text-gumas-red"></i>
                </div>
                <h3 class="font-oswald text-2xl uppercase tracking-wider text-black dark:text-white mb-4">@L["About_Mission"]</h3>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                    @L["About_MissionText"]
                </p>
            </div>

            <!-- Vision -->
            <div class="bg-white dark:bg-gumas-gray border border-gray-200 dark:border-white/10 p-12 hover:border-gumas-red transition-colors duration-300">
                <div class="w-16 h-16 bg-gumas-red/10 flex items-center justify-center mb-6">
                    <i class="fa-solid fa-eye text-2xl text-gumas-red"></i>
                </div>
                <h3 class="font-oswald text-2xl uppercase tracking-wider text-black dark:text-white mb-4">@L["About_Vision"]</h3>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                    @L["About_VisionText"]
                </p>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="container mx-auto px-6 mb-20 relative z-10">
        <div class="bg-gumas-dark dark:bg-gumas-gray p-12 md:p-20">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div class="text-center">
                    <span class="block text-5xl md:text-6xl font-oswald font-bold text-white mb-2">25+</span>
                    <span class="text-sm uppercase tracking-widest text-gray-400">@L["About_YearsExperience"]</span>
                </div>
                <div class="text-center">
                    <span class="block text-5xl md:text-6xl font-oswald font-bold text-white mb-2">10K+</span>
                    <span class="text-sm uppercase tracking-widest text-gray-400">@L["About_ProductVariety"]</span>
                </div>
                <div class="text-center">
                    <span class="block text-5xl md:text-6xl font-oswald font-bold text-white mb-2">5K+</span>
                    <span class="text-sm uppercase tracking-widest text-gray-400">@L["About_HappyCustomers"]</span>
                </div>
                <div class="text-center">
                    <span class="block text-5xl md:text-6xl font-oswald font-bold text-gumas-red mb-2">7+</span>
                    <span class="text-sm uppercase tracking-widest text-gray-400">@L["About_BrandPartnerships"]</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="container mx-auto px-6 mb-20 relative z-10">
        <h2 class="text-4xl md:text-5xl font-oswald font-bold uppercase mb-12 text-black dark:text-white">
            @L["About_OurValues"]<span class="text-gumas-red">@L["About_OurValuesSuffix"]</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Value 1 -->
            <div class="group p-8 border border-gray-200 dark:border-white/10 hover:border-gumas-red transition-colors duration-300">
                <div class="w-12 h-12 bg-gumas-red/10 flex items-center justify-center mb-6 group-hover:bg-gumas-red transition-colors duration-300">
                    <i class="fa-solid fa-award text-xl text-gumas-red group-hover:text-white transition-colors duration-300"></i>
                </div>
                <h4 class="font-oswald text-xl uppercase tracking-wider text-black dark:text-white mb-3">@L["About_Value_Quality"]</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @L["About_Value_QualityDesc"]
                </p>
            </div>

            <!-- Value 2 -->
            <div class="group p-8 border border-gray-200 dark:border-white/10 hover:border-gumas-red transition-colors duration-300">
                <div class="w-12 h-12 bg-gumas-red/10 flex items-center justify-center mb-6 group-hover:bg-gumas-red transition-colors duration-300">
                    <i class="fa-solid fa-handshake text-xl text-gumas-red group-hover:text-white transition-colors duration-300"></i>
                </div>
                <h4 class="font-oswald text-xl uppercase tracking-wider text-black dark:text-white mb-3">@L["About_Value_Reliability"]</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @L["About_Value_ReliabilityDesc"]
                </p>
            </div>

            <!-- Value 3 -->
            <div class="group p-8 border border-gray-200 dark:border-white/10 hover:border-gumas-red transition-colors duration-300">
                <div class="w-12 h-12 bg-gumas-red/10 flex items-center justify-center mb-6 group-hover:bg-gumas-red transition-colors duration-300">
                    <i class="fa-solid fa-bolt text-xl text-gumas-red group-hover:text-white transition-colors duration-300"></i>
                </div>
                <h4 class="font-oswald text-xl uppercase tracking-wider text-black dark:text-white mb-3">@L["About_Value_Speed"]</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @L["About_Value_SpeedDesc"]
                </p>
            </div>

            <!-- Value 4 -->
            <div class="group p-8 border border-gray-200 dark:border-white/10 hover:border-gumas-red transition-colors duration-300">
                <div class="w-12 h-12 bg-gumas-red/10 flex items-center justify-center mb-6 group-hover:bg-gumas-red transition-colors duration-300">
                    <i class="fa-solid fa-users text-xl text-gumas-red group-hover:text-white transition-colors duration-300"></i>
                </div>
                <h4 class="font-oswald text-xl uppercase tracking-wider text-black dark:text-white mb-3">@L["About_Value_CustomerFocus"]</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @L["About_Value_CustomerFocusDesc"]
                </p>
            </div>

            <!-- Value 5 -->
            <div class="group p-8 border border-gray-200 dark:border-white/10 hover:border-gumas-red transition-colors duration-300">
                <div class="w-12 h-12 bg-gumas-red/10 flex items-center justify-center mb-6 group-hover:bg-gumas-red transition-colors duration-300">
                    <i class="fa-solid fa-chart-line text-xl text-gumas-red group-hover:text-white transition-colors duration-300"></i>
                </div>
                <h4 class="font-oswald text-xl uppercase tracking-wider text-black dark:text-white mb-3">@L["About_Value_Improvement"]</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @L["About_Value_ImprovementDesc"]
                </p>
            </div>

            <!-- Value 6 -->
            <div class="group p-8 border border-gray-200 dark:border-white/10 hover:border-gumas-red transition-colors duration-300">
                <div class="w-12 h-12 bg-gumas-red/10 flex items-center justify-center mb-6 group-hover:bg-gumas-red transition-colors duration-300">
                    <i class="fa-solid fa-globe text-xl text-gumas-red group-hover:text-white transition-colors duration-300"></i>
                </div>
                <h4 class="font-oswald text-xl uppercase tracking-wider text-black dark:text-white mb-3">@L["About_Value_GlobalVision"]</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                    @L["About_Value_GlobalVisionDesc"]
                </p>
            </div>
        </div>
    </section>


</main>
