@model HomeViewModel
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEnglish = currentCulture == "en";
    ViewData["Title"] = isEnglish ? "Home" : "Ana Sayfa";
}

@{
    var firstSlider = Model.Sliders.FirstOrDefault();
    var heroImage = firstSlider?.ImageUrl ?? "/images/9.jpg";
}

<!-- Hero Section - Single Full Screen Image -->
<section class="relative w-full overflow-hidden" style="height: calc(100vh - 56px); margin-top: 56px;">
    <div class="absolute inset-0">
        <img src="@heroImage"
             alt="GÜMAŞ Otomotiv"
             class="w-full h-full object-cover" />
    </div>
</section>
