@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEnglish = currentCulture == "en";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!DOCTYPE html>
<html lang="@currentCulture" class="no-js">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - GÜMAŞ Otomotiv</title>
    @{
        var metaDescription = ViewData["MetaDescription"]?.ToString() ?? (isEnglish
            ? "GÜMAŞ Automotive - Heavy vehicle spare parts supplier. Original and equivalent spare parts for Mercedes, MAN, Volvo, Scania, DAF, Iveco, Renault brands."
            : "GÜMAŞ Otomotiv - Ağır vasıta yedek parça tedarikçisi. Mercedes, MAN, Volvo, Scania, DAF, Iveco, Renault markaları için orijinal ve eşdeğer yedek parçalar.");
        var ogImage = ViewData["OgImage"]?.ToString() ?? "/images/og-default.jpg";
        var pageTitle = ViewData["Title"]?.ToString() ?? "GÜMAŞ Otomotiv";
        var canonicalUrl = baseUrl + currentUrl;
    }
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@(isEnglish ? "heavy vehicle spare parts, truck parts, bus parts, trailer parts, JOST, TRIDEC, Rockinger, fifth wheel, steering system" : "ağır vasıta yedek parça, kamyon parçası, otobüs parçası, treyler parçası, JOST, TRIDEC, Rockinger, beşinci teker, direksiyon sistemi")" />
    <meta name="author" content="GÜMAŞ Otomotiv" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle - GÜMAŞ Otomotiv" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:image" content="@baseUrl@ogImage" />
    <meta property="og:locale" content="@(isEnglish ? "en_US" : "tr_TR")" />
    <meta property="og:locale:alternate" content="@(isEnglish ? "tr_TR" : "en_US")" />
    <meta property="og:site_name" content="GÜMAŞ Otomotiv" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="@pageTitle - GÜMAŞ Otomotiv" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@baseUrl@ogImage" />

    <!-- Hreflang Tags for SEO -->
    <link rel="alternate" hreflang="tr" href="@baseUrl@GetTurkishUrl(currentUrl)" />
    <link rel="alternate" hreflang="en" href="@baseUrl@GetEnglishUrl(currentUrl)" />
    <link rel="alternate" hreflang="x-default" href="@baseUrl@GetTurkishUrl(currentUrl)" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "GÜMAŞ Otomotiv",
        "alternateName": "Gümaş A.Ş.",
        "url": "@baseUrl",
        "logo": "@baseUrl/images/logo.png",
        "description": "@(isEnglish ? "Heavy vehicle spare parts supplier since 1985" : "1985'ten beri ağır vasıta yedek parça tedarikçisi")",
        "foundingDate": "1985",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Dolapdere Taksim Cad. No:35 Kat:2",
            "addressLocality": "Beyoğlu",
            "addressRegion": "İstanbul",
            "postalCode": "34437",
            "addressCountry": "TR"
        },
        "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+90-212-254-78-05",
            "contactType": "customer service",
            "availableLanguage": ["Turkish", "English"]
        },
        "sameAs": [
            "https://www.linkedin.com/company/gümaş-a-ş/"
        ]
    }
    </script>
    @RenderSection("StructuredData", required: false)

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Oswald:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Tailwind Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gumas: {
                            dark: '#0f0f0f',
                            bg: '#0a0a0a',
                            light: '#e5e5e5',
                            red: '#D32F2F',
                            accent: '#FF3D00',
                            steel: '#4A5568',
                            gray: '#2d2d2d'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        oswald: ['Oswald', 'sans-serif'],
                    },
                    cursor: {
                        'none': 'none',
                    }
                }
            }
        }
    </script>

    <!-- Custom CSS -->
    <style>
        body {
            background-color: #0f0f0f;
            color: #e5e5e5;
            overflow-x: hidden;
        }

        html.lenis { height: auto; }
        .lenis.lenis-smooth { scroll-behavior: auto; }
        .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
        .lenis.lenis-stopped { overflow: hidden; }

        /* Swiper Customization */
        .swiper-slide { overflow: hidden; }
        .slide-bg { transition: transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); }

        /* Text Reveal Mask */
        .text-reveal { overflow: hidden; display: inline-block; }
        .text-reveal span {
            display: inline-block;
            transform: translateY(110%);
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .swiper-slide-active .text-reveal span { transform: translateY(0); }

        /* Sharp Edges Utility */
        .sharp-btn { clip-path: polygon(0 0, 100% 0, 100% 70%, 90% 100%, 0 100%); }

        /* Mobile menu */
        .mobile-menu { transform: translateX(100%); transition: transform 0.3s ease-in-out; }
        .mobile-menu.active { transform: translateX(0); }

        /* Floating animation */
        .floating-part { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        /* Product card hover */
        .product-card-landing:hover img { filter: grayscale(0); }
        .product-card-landing img { filter: grayscale(100%); transition: filter 0.5s; }
    </style>

    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark')
        } else {
            document.documentElement.classList.remove('dark')
        }
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="font-sans antialiased text-gray-900 bg-gray-50 dark:bg-gumas-dark dark:text-gumas-light transition-colors duration-300 selection:bg-gumas-red selection:text-white">

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 px-6 py-6 flex justify-between items-center bg-white/50 dark:bg-black/50 backdrop-blur-md transition-colors duration-300 border-b border-black/5 dark:border-white/5">
        <a href="@(isEnglish ? "/en" : "/")" class="flex items-center">
            <img src="/images/logo/gumas_logo_light.png" alt="GÜMAŞ" class="h-16 block dark:hidden transition-all duration-300" />
            <img src="/images/logo/gumas_logo_dark.png" alt="GÜMAŞ" class="h-16 hidden dark:block transition-all duration-300" />
        </a>

        <div class="hidden md:flex space-x-10 font-oswald text-sm tracking-widest uppercase opacity-80 text-black dark:text-white">
            <!-- Products Dropdown -->
            <div class="relative group">
                <a href="@(isEnglish ? "/en/products" : "/urunler")" class="hover:text-gumas-red transition-colors flex items-center gap-1">
                    @L["Nav_Products"]
