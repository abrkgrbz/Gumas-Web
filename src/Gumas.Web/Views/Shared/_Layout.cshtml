                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </a>
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                    <div class="bg-white dark:bg-gumas-dark border border-gray-200 dark:border-white/10 shadow-xl min-w-[220px] py-3">
                        <a href="@(isEnglish ? "/en/brand/jost" : "/marka/jost")" class="block px-6 py-2.5 text-xs tracking-widest hover:bg-gumas-red hover:text-white transition-colors">JOST</a>
                        <a href="@(isEnglish ? "/en/brand/rockinger" : "/marka/rockinger")" class="block px-6 py-2.5 text-xs tracking-widest hover:bg-gumas-red hover:text-white transition-colors">ROCKINGER</a>
                        <button type="button" onclick="document.getElementById('nav-tridec-modal').style.display='flex'" class="w-full text-left block px-6 py-2.5 text-xs tracking-widest hover:bg-gumas-red hover:text-white transition-colors uppercase font-oswald">
                            TRIDEC <i class="fas fa-chevron-down text-[9px] ml-1 opacity-60"></i>
                        </button>
                        <a href="@(isEnglish ? "/en/brand/quicke" : "/marka/quicke")" class="block px-6 py-2.5 text-xs tracking-widest hover:bg-gumas-red hover:text-white transition-colors">QUICKE</a>
                        <button type="button" onclick="document.getElementById('nav-gerflor-modal').style.display='flex'" class="w-full text-left block px-6 py-2.5 text-xs tracking-widest hover:bg-gumas-red hover:text-white transition-colors uppercase font-oswald">
                            GERFLOR <i class="fas fa-chevron-down text-[9px] ml-1 opacity-60"></i>
                        </button>
                        <a href="https://www.sirit.it/eng/catalogo_generale_sirit.pdf" target="_blank" rel="noopener" class="block px-6 py-2.5 text-xs tracking-widest hover:bg-gumas-red hover:text-white transition-colors">
                            SIRIT <i class="fas fa-external-link-alt text-[9px] ml-1 opacity-60"></i>
                        </a>
                    </div>
                </div>
            </div>
            <a href="@(isEnglish ? "/en/brands" : "/markalar")" class="hover:text-gumas-red transition-colors">@L["Nav_Brands"]</a>
            <a href="@(isEnglish ? "/en/e-catalogue" : "/e-katalog")" class="hover:text-gumas-red transition-colors">@L["Nav_ECatalog"]</a>
            <a href="@(isEnglish ? "/en/about" : "/hakkimizda")" class="hover:text-gumas-red transition-colors">@L["Nav_About"]</a>
            <a href="@(isEnglish ? "/en/contact" : "/iletisim")" class="hover:text-gumas-red transition-colors">@L["Nav_Contact"]</a>
        </div>

        <div class="flex items-center space-x-6 text-black dark:text-white">
            <!-- Language Switcher (Server-side) -->
            <div class="hidden md:flex items-center space-x-1 font-oswald text-sm tracking-widest">
                <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="inline">
                    <input type="hidden" name="culture" value="tr" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button type="submit" class="px-2 py-1 uppercase hover:text-gumas-red transition-colors @(currentCulture == "tr" ? "text-gumas-red font-bold" : "opacity-50")">TR</button>
                </form>
                <span class="text-gray-400">|</span>
                <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="inline">
                    <input type="hidden" name="culture" value="en" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button type="submit" class="px-2 py-1 uppercase hover:text-gumas-red transition-colors @(currentCulture == "en" ? "text-gumas-red font-bold" : "opacity-50")">EN</button>
                </form>
            </div>

            <button id="theme-switch" class="hover:text-gumas-red transition-colors">
                <svg id="icon-sun" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <svg id="icon-moon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
            </button>
            <a href="@(isEnglish ? "/en/contact" : "/iletisim")" class="font-oswald border border-black/30 dark:border-white/30 px-6 py-2 uppercase text-sm tracking-widest hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all duration-300">
                @L["Nav_GetQuote"]
            </a>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="mobile-menu fixed top-0 right-0 w-64 h-full bg-white dark:bg-gumas-dark z-50 p-8 pt-20 border-l border-gray-200 dark:border-white/10">
        <button id="mobile-menu-close" class="absolute top-6 right-6 text-black dark:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
        <div class="flex flex-col space-y-5 font-oswald text-lg uppercase tracking-widest text-black dark:text-white">
            <div>
                <button type="button" id="mobile-products-toggle" class="flex items-center justify-between w-full hover:text-gumas-red transition-colors">
                    <span>@L["Nav_Products"]</span>
                    <svg class="w-4 h-4 transition-transform" id="mobile-products-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div id="mobile-products-submenu" class="hidden flex-col space-y-3 mt-4 pl-4 border-l border-gray-200 dark:border-white/10 text-sm">
                    <a href="@(isEnglish ? "/en/brand/jost" : "/marka/jost")" class="hover:text-gumas-red transition-colors">JOST</a>
                    <a href="@(isEnglish ? "/en/brand/rockinger" : "/marka/rockinger")" class="hover:text-gumas-red transition-colors">ROCKINGER</a>
                    <a href="@(isEnglish ? "/en/brand/tridec" : "/marka/tridec")" class="hover:text-gumas-red transition-colors">TRIDEC</a>
                    <a href="@(isEnglish ? "/en/brand/quicke" : "/marka/quicke")" class="hover:text-gumas-red transition-colors">QUICKE</a>
                    <a href="https://www.gerflortransport.com/en" target="_blank" rel="noopener" class="hover:text-gumas-red transition-colors">GERFLOR</a>
                    <a href="https://www.sirit.it/eng/catalogo_generale_sirit.pdf" target="_blank" rel="noopener" class="hover:text-gumas-red transition-colors">SIRIT</a>
                </div>
            </div>
            <a href="@(isEnglish ? "/en/brands" : "/markalar")" class="hover:text-gumas-red transition-colors">@L["Nav_Brands"]</a>
            <a href="@(isEnglish ? "/en/e-catalogue" : "/e-katalog")" class="hover:text-gumas-red transition-colors">@L["Nav_ECatalog"]</a>
            <a href="@(isEnglish ? "/en/about" : "/hakkimizda")" class="hover:text-gumas-red transition-colors">@L["Nav_About"]</a>
            <a href="@(isEnglish ? "/en/contact" : "/iletisim")" class="hover:text-gumas-red transition-colors">@L["Nav_Contact"]</a>
        </div>
        <!-- Mobile Language Switcher -->
        <div class="flex items-center space-x-4 mt-8 pt-6 border-t border-gray-200 dark:border-white/10">
            <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="inline">
                <input type="hidden" name="culture" value="tr" />
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <button type="submit" class="font-oswald text-sm uppercase tracking-widest hover:text-gumas-red transition-colors @(currentCulture == "tr" ? "text-gumas-red font-bold" : "opacity-50")">TR</button>
            </form>
            <span class="text-gray-400">|</span>
            <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="inline">
                <input type="hidden" name="culture" value="en" />
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <button type="submit" class="font-oswald text-sm uppercase tracking-widest hover:text-gumas-red transition-colors @(currentCulture == "en" ? "text-gumas-red font-bold" : "opacity-50")">EN</button>
            </form>
        </div>
    </div>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-black py-12 border-t border-gray-200 dark:border-white/10 transition-colors duration-300">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
                <!-- Brand -->
                <div>
                    <img src="/images/logo/gumas_logo_light.png" alt="GÜMAŞ" class="h-10 mb-4 block dark:hidden" />
                    <img src="/images/logo/gumas_logo_dark.png" alt="GÜMAŞ" class="h-10 mb-4 hidden dark:block" />
