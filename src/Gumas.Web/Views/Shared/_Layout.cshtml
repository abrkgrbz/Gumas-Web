@functions {
    string GetEnglishUrl(string url)
    {
        if (string.IsNullOrEmpty(url) || url == "/") return "/en";
        if (url.StartsWith("/en")) return url;

        return url
            .Replace("/urunler", "/en/products")
            .Replace("/urun/", "/en/product/")
            .Replace("/markalar", "/en/brands")
            .Replace("/marka/", "/en/brand/")
            .Replace("/e-katalog", "/en/e-catalogue")
            .Replace("/haberler", "/en/news")
            .Replace("/haber/", "/en/news/")
            .Replace("/hakkimizda", "/en/about")
            .Replace("/iletisim", "/en/contact");
    }

    string GetTurkishUrl(string url)
    {
        if (string.IsNullOrEmpty(url) || url == "/en" || url == "/") return "/";
        if (!url.StartsWith("/en")) return url;

        return url
            .Replace("/en/products", "/urunler")
            .Replace("/en/product/", "/urun/")
            .Replace("/en/brands", "/markalar")
            .Replace("/en/brand/", "/marka/")
            .Replace("/en/e-catalogue", "/e-katalog")
            .Replace("/en/news", "/haberler")
            .Replace("/en/about", "/hakkimizda")
            .Replace("/en/contact", "/iletisim")
            .Replace("/en", "/");
    }
}
